text = input("Введите строку: ")
clean_text = text.lower().replace(" ", "").replace(",", "").replace(".", "").replace("!", "").replace("?", "").replace("-", "")

if clean_text == clean_text[::-1]:
    print("Это палиндром")
else:
    print("Это не палиндром")
