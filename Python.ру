even_list = []
odd_list = []
neg_list = []
pos_list = []

for i in range(len(a)):
    if a[i] % 2 == 0:
        even_list.append(a[i])
    else:
        odd_list.append(a[i])
    if a[i] < 0:
        neg_list.append(a[i])
    if a[i] > 0:
        pos_list.append(a[i])

